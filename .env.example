VITE_API_BASE_URL=https://your-production-backend.example.com
VITE_GOOGLE_MAPS_API_KEY=your_restricted_browser_key
VITE_GOOGLE_MAPS_ANDROID_WEBVIEW_API_KEY=your_android_webview_restricted_browser_key

# --- Future VICIdial support-call integration (post Play Store launch) ---
# Leave unset until VICIdial is actually connected. Until then the customer
# dashboard's "Call Support" action falls back to the configured support
# phone number. See src/services/supportCallService.js.
# VITE_VICIDIAL_ENABLED=false

# The following are backend-only placeholders — do NOT prefix them with
# VITE_ (that exposes a value to the client bundle) and do NOT commit real
# credentials here. They document what the backend will need once it calls
# VICIdial's API on the customer's behalf.
# VICIDIAL_BASE_URL=
# VICIDIAL_API_USER=
# VICIDIAL_API_PASSWORD=
